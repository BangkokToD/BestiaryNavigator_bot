    for it in items:
        ax.text(0.12,y,f"• {it}", fontsize=9, ha='left', va='center')
        y-=0.08
    return make_image_bytes(fig)

def compute_word_char_count(text):
    # Ukrainian/Russian words separated by whitespace; chars excluding spaces
    words = re.findall(r'\S+', text)
    chars_no_spaces = len(re.sub(r'\s+', '', text))
    chars_with_spaces = len(text)
    return len(words), chars_no_spaces, chars_with_spaces

