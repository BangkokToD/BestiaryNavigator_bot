from docx import Document
from docx.shared import Cm, Pt, RGBColor, Inches
from docx.enum.text import WD_ALIGN_PARAGRAPH, WD_UNDERLINE
from docx.oxml import OxmlElement
from docx.oxml.ns import qn
from docx.enum.section import WD_SECTION
from docx.enum.table import WD_TABLE_ALIGNMENT
import re, math, io
import matplotlib.pyplot as plt
from pathlib import Path

OUT_DIR = Path(__file__).resolve().parent
OUT_PATH = OUT_DIR / "ПР1_Виконано_без_Excel.docx"

def add_page_border(section):
    # Simple single line border on all sides
    sectPr = section._sectPr
    pgBorders = sectPr.find(qn('w:pgBorders'))
    if pgBorders is None:
        pgBorders = OxmlElement('w:pgBorders')
        pgBorders.set(qn('w:offsetFrom'), 'page')
        sectPr.append(pgBorders)
    for side in ('top','left','bottom','right'):
        el = pgBorders.find(qn(f'w:{side}'))
        if el is None:
            el = OxmlElement(f'w:{side}')
            pgBorders.append(el)
        el.set(qn('w:val'), 'single')
        el.set(qn('w:sz'), '12')      # 1.5 pt
        el.set(qn('w:space'), '24')   # distance
        el.set(qn('w:color'), '000000')

def add_field_run(paragraph, field_code):
    # Adds a Word field (e.g., PAGE, TOC)
    r = paragraph.add_run()
    fldChar1 = OxmlElement('w:fldChar'); fldChar1.set(qn('w:fldCharType'), 'begin')
    instrText = OxmlElement('w:instrText'); instrText.set(qn('xml:space'), 'preserve')
    instrText.text = field_code
    fldChar2 = OxmlElement('w:fldChar'); fldChar2.set(qn('w:fldCharType'), 'separate')
    fldChar3 = OxmlElement('w:fldChar'); fldChar3.set(qn('w:fldCharType'), 'end')
    r._r.append(fldChar1); r._r.append(instrText); r._r.append(fldChar2); r._r.append(fldChar3)
    return r

def set_default_style(doc):
    style = doc.styles['Normal']
    style.font.name = 'Times New Roman'
    style._element.rPr.rFonts.set(qn('w:eastAsia'), 'Times New Roman')
    style.font.size = Pt(14)
    p = style.paragraph_format
    p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    p.first_line_indent = Cm(1.25)
    p.line_spacing = 1.0

def heading(doc, text, level=1):
    p = doc.add_paragraph(text, style=f'Heading {level}')
    return p

def page_break(doc):
    doc.add_page_break()

def add_footer_page_number(section):
    footer = section.footer
    p = footer.paragraphs[0] if footer.paragraphs else footer.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    add_field_run(p, " PAGE ")

def add_header_executor(section, text):
    header = section.header
    p = header.paragraphs[0] if header.paragraphs else header.add_paragraph()
    p.text = text
    p.alignment = WD_ALIGN_PARAGRAPH.LEFT
    for run in p.runs:
        run.font.name = 'Times New Roman'
        run.font.size = Pt(12)

def make_image_bytes(fig):
    bio = io.BytesIO()
    fig.savefig(bio, format='png', dpi=200, bbox_inches='tight')
    plt.close(fig)
    bio.seek(0)
    return bio

def chart_line_revenue():
    years = [2020, 2021, 2022]
    series = {
        "Іноземні громадяни": [307653, 370475, 861448],
        "Громадяни України": [567078, 624424, 982198],
        "Оренда приміщень": [135129, 147923.8, 169657.4],
        "Бронювання": [61593.7, 59657.4, 56010],
    }
    fig, ax = plt.subplots(figsize=(7.2, 4.2))
    for name, vals in series.items():
        ax.plot(years, vals, marker='o', label=name)
        for x,y in zip(years, vals):
            ax.text(x, y, f"{y:.0f}" if abs(y-round(y))<1e-6 else f"{y:.1f}", fontsize=7)
    ax.set_xlabel("Рік")
    ax.set_ylabel("грн.")
    ax.grid(True)
    ax.legend(fontsize=7, loc='center left', bbox_to_anchor=(1.02, 0.5))
    return make_image_bytes(fig)

def chart_pie_structure():
    labels = [
        "Розміщення туристів",
        "Громадське харчування",
        "Торгівля",
        "Екскурсії та розваги",
        "Транспортні послуги",
        "Послуги зв'язку, побутові та інші",
    ]
    sizes = [32,25,24,9,4,6]
    fig, ax = plt.subplots(figsize=(6.5, 3.8))
    ax.pie(sizes, labels=[f"{l} ({s}%)" for l,s in zip(labels,sizes)], autopct='%1.0f%%', textprops={'fontsize':7})
    ax.axis('equal')
    return make_image_bytes(fig)

def image_equation():
    fig, ax = plt.subplots(figsize=(5.8, 1.3))
    ax.axis('off')
    ax.text(0.5, 0.5, r"$R_s=\frac{\sum_{i=1}^{n}(Ц_i-S_i)}{\sum_{i=1}^{n}S_i}\cdot 100\%$", ha='center', va='center', fontsize=18)
    return make_image_bytes(fig)

def image_scheme_simple(title):
    fig, ax = plt.subplots(figsize=(7.2, 4.0))
    ax.axis('off')
    # boxes
    boxes = {
        "Готель": (0.05, 0.85),
        "Дохід": (0.45, 0.72),
        "Прибуток": (0.45, 0.88),
        "Обсяг продаж\n(кількість обслуг.)": (0.15, 0.52),
        "Ціна": (0.55, 0.52),
        "Формування\nконкурентних\nпереваг": (0.35, 0.28),
        "Підприємство": (0.05, 0.10),
        "Обсяги продаж\nтоварів для\nномерного фонду": (0.60, 0.10),
    }
    def draw_box(text, xy):
        x,y=xy
        ax.add_patch(plt.Rectangle((x,y), 0.28, 0.12, fill=False, linewidth=1))
        ax.text(x+0.14, y+0.06, text, ha='center', va='center', fontsize=8)
    for t,xy in boxes.items():
        draw_box(t, xy)
    # arrows (approx)
    arrows = [
        ((0.29,0.58),(0.45,0.78)),
        ((0.69,0.58),(0.59,0.78)),
        ((0.59,0.78),(0.59,0.90)),
        ((0.45,0.84),(0.29,0.58)),
        ((0.45,0.34),(0.69,0.16)),
        ((0.74,0.16),(0.69,0.58)),
    ]
    for (x1,y1),(x2,y2) in arrows:
        ax.annotate("", xy=(x2,y2), xytext=(x1,y1), arrowprops=dict(arrowstyle="->", lw=1))
    ax.set_title(title, fontsize=10, pad=8)
    return make_image_bytes(fig)

def image_org_chart():
    fig, ax = plt.subplots(figsize=(7.2, 3.6))
    ax.axis('off')
    # simple org chart
    ax.add_patch(plt.Rectangle((0.38,0.82), 0.24, 0.12, fill=False))
    ax.text(0.50, 0.88, "ДИРЕКТОР", ha='center', va='center', fontsize=9)
    roles = [
        "БУХГАЛТЕРІЯ",
        "ВІДДІЛ ПРИЙОМУ",
        "ВІДДІЛ ЕКСПЛУАТАЦІЇ",
        "ВІДДІЛ ПРОГРАМНОГО ЗАБЕЗПЕЧЕННЯ",
        "ЗАГАЛЬНИЙ ВІДДІЛ",
        "ВІДДІЛ ТРАНСПОРТНО-ЕКСКУРСІЙНОГО\nОБСЛУГОВУВАННЯ",
        "ВІДДІЛ З ПРОДАЖУ КВИТКІВ",
    ]
    y = 0.64
    for r in roles:
        ax.add_patch(plt.Rectangle((0.22,y), 0.56, 0.08, fill=False))
        ax.text(0.50, y+0.04, r, ha='center', va='center', fontsize=8)
        # connector line
        ax.plot([0.50,0.50],[0.82,y+0.08], lw=0.8)
        y -= 0.10
    return make_image_bytes(fig)

def image_competitiveness_tree():
    fig, ax = plt.subplots(figsize=(7.2, 4.4))
    ax.axis('off')
    ax.add_patch(plt.Circle((0.5,0.90), 0.12, fill=False, lw=1.2))
    ax.text(0.5,0.90,"Параметри\nконкурентоспроможності\nтуристичного\nпідприємства", ha='center', va='center', fontsize=8)
    nodes = [
        ("Конкурентоспромож-\nність обслуговування", (0.15,0.65)),
        ("Конкурентоспромож-\nність туристичного\nпродукту", (0.42,0.65)),
        ("Ефективність\nдіяльності", (0.62,0.65)),
        ("Фінансовий\nстан", (0.85,0.65)),
    ]
    for text,(x,y) in nodes:
        ax.add_patch(plt.Circle((x,y), 0.09, fill=False))
        ax.text(x,y,text, ha='center', va='center', fontsize=7)
        ax.annotate("", xy=(x,y+0.09), xytext=(0.5,0.78), arrowprops=dict(arrowstyle="->", lw=1))
    return make_image_bytes(fig)

