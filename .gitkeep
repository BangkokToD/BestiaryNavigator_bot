t.style = 'Table Grid'
hdr = t.rows[0].cells
hdr[0].text = ""
for j,y in enumerate(years):
    hdr[j+1].text = y

totals_by_year = [0,0,0]
for i,(name,a,b,c) in enumerate(data, start=1):
    row = t.rows[i].cells
    row[0].text = name
    vals = [a,b,c]
