# Insert TOC page at beginning: create new section at start is hard; we add page break after TOC later.
# We'll create a TOC at the very start by inserting paragraphs at document beginning using XML.
# Approach: insert a new paragraph at start with field code, preceded by blank page.
# We'll do it by moving elements (simple: create a new doc then append). We'll rebuild quickly.

def clone_with_toc(original_doc):
    new = Document()
    set_default_style(new)
    # Copy section settings
    s0 = new.sections[0]
    for attr in ('page_height','page_width','top_margin','bottom_margin','left_margin','right_margin'):
        setattr(s0, attr, getattr(original_doc.sections[0], attr))
    s0.different_first_page_header_footer = True
    add_page_border(s0)
    add_footer_page_number(s0)
    add_header_executor(s0, "Виконавець: Прізвище І.Б., № групи ______")
    # First page: TOC
    toc_title = new.add_paragraph("ЗМІСТ")
    toc_title.alignment = WD_ALIGN_PARAGRAPH.CENTER
    toc_title.runs[0].bold = True
    toc_title.runs[0].font.name = "Times New Roman"
    toc_title.runs[0].font.size = Pt(16)
    toc = new.add_paragraph()
    toc.paragraph_format.line_spacing = 1.5
    toc.paragraph_format.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    for r in toc.runs:
        r.font.name = "Times New Roman"
    add_field_run(toc, r' TOC \o "1-3" \h \z \u ')
    new.add_page_break()
    # Append body from original
    for element in original_doc.element.body:
        new.element.body.append(element)
    return new

doc2 = clone_with_toc(doc)

doc2.save(str(OUT_PATH))
print("Saved:", OUT_PATH)
