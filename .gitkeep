        totals_by_year[k] += v
        row[k+1].text = f"{v}".replace('.',',')
    row[4].text = f"{sum(vals)}".replace('.',',')
# totals row
row = t.rows[len(data)+1].cells
row[0].text = "Разом:"
for k,v in enumerate(totals_by_year):
    row[k+1].text = f"{v}".replace('.',',')
row[4].text = f"{sum(totals_by_year)}".replace('.',',')

